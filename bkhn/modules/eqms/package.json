{
  "name": "eqms",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm test && npm run build",
    "preview:worker": "npm run build && wrangler dev",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run check && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "wrangler": "^4.136.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "bootstrap": "5.3.8",
    "chart.js": "4.5.1",
    "datatables.net": "1.13.11",
    "datatables.net-bs5": "1.13.11",
    "jquery": "3.7.1"
  }
}
